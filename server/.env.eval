# Services used by `npm run eval:*`. Committed on purpose: no secrets here.
# API keys (OPENAI_API_KEY, COHERE_API_KEY) still come from server/.env.
# Evals refuse to start if these point at the app's production hosts or at any
# non-local host, unless EVAL_ALLOW_REMOTE_SERVICES=true.

EVAL_QDRANT_URL=http://localhost:6333
EVAL_QDRANT_COLLECTION=devai_eval_01
# EVAL_QDRANT_API_KEY=

EVAL_MONGO_URI=mongodb://localhost:27017/devai_eval

# EVAL_ALLOW_REMOTE_SERVICES=false
